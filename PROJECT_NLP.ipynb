        "id": "610478a8-ad66-4b0c-8381-d56de9d8f3ad"
      },
      "source": [
        "## 8. Evaluation function  \n",
        "Reusable function to compute all required metrics (accuracy, precision, recall, F1) exactly as expected in the task."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 9,
      "id": "52d71a71-cad0-43a4-8e76-c75bbc0189df",
      "metadata": {
        "id": "52d71a71-cad0-43a4-8e76-c75bbc0189df"
      },
      "outputs": [],
      "source": [
        "# ================================================\n",
        "# EVALUATION FUNCTION\n",
        "# ================================================\n",
        "\n",
        "def evaluate_model(y_true, y_pred, model_name, subset_size):\n",
        "    \"\"\"Compute and print Accuracy, Precision, Recall and F1 for positive class.\"\"\"\n",
        "    acc = accuracy_score(y_true, y_pred)\n",
        "    prec = precision_score(y_true, y_pred, pos_label='positive', zero_division=0)\n",
        "    rec = recall_score(y_true, y_pred, pos_label='positive', zero_division=0)\n",
        "    f1 = f1_score(y_true, y_pred, pos_label='positive', zero_division=0)\n",
        "\n",
        "    print(f\"\\n🔍 {model_name} on {subset_size:,} samples\")\n",
        "    print(f\"Accuracy : {acc:.4f} | Precision: {prec:.4f} | Recall: {rec:.4f} | F1: {f1:.4f}\")\n",
        "    return acc, prec, rec, f1"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "65b12750-1f5e-486a-8425-b9f228eaa290",
